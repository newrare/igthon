# IG API
IG_ENV=demo
IG_API_KEY=your_api_key
IG_USERNAME=your_username
IG_PASSWORD=your_password
IG_ACCOUNT_ID=your_account_id

# Database
# Local dev (SQLite — no server needed):
DATABASE_URL=sqlite:///./ig_trading.db
# Production (PostgreSQL on a dedicated server):
# DATABASE_URL=postgresql://user:password@localhost:5432/ig_trading

# Web Interface
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Open/close selection — entry strategy and close profile are decoupled and
# picked independently. Entry (open) decides direction only; the close profile
# owns the stop/target/trailing. Registered names: src/entry/__init__.py and
# src/exit/__init__.py.
ENTRY_STRATEGY_NAME=donchian_er
CLOSE_PROFILE_NAME=atr_trailing
# Deprecated alias kept for the legacy strategies/ registry (not-yet-ported
# entries); new code reads ENTRY_STRATEGY_NAME.
STRATEGY_NAME=donchian_er

# Donchian breakout + Efficiency-Ratio regime gate (STRATEGY_NAME=donchian_er)
STRATEGY_DONCHIAN_CHANNEL=20
STRATEGY_DONCHIAN_STOP_ATR_K=2.5
STRATEGY_EFFICIENCY_PERIOD=30
STRATEGY_MIN_EFFICIENCY=0.60

# Trend follower (STRATEGY_NAME=trend_follower) — Trend Volume Intraday
STRATEGY_MIN_R2=0.70
STRATEGY_MIN_SCORE=0.75
STRATEGY_LOOKBACK_POINTS=20
STRATEGY_SMA_FAST=5
STRATEGY_SMA_SLOW=20
STRATEGY_ROC_PERIOD=10
STRATEGY_MAX_SPREAD_RATIO=0.0010
STRATEGY_STOP_MULTIPLIER=2.5
STRATEGY_TARGET_MULTIPLIER=4.0
STRATEGY_TACTIC=spread

# Momentum scalper (STRATEGY_NAME=momentum_scalper) — high-frequency volume
STRATEGY_SCALPER_MOMENTUM_PERIOD=8
STRATEGY_SCALPER_MIN_ROC=0.20
STRATEGY_SCALPER_CONFIRM_PERIOD=1
STRATEGY_SCALPER_WIN_RATIO=4.0
STRATEGY_SCALPER_STOP_LOOKBACK=60
STRATEGY_SCALPER_STOP_BUFFER_ATR_K=0.5
STRATEGY_SCALPER_MAX_STOP_ATR_K=3.0

# Trend template (STRATEGY_NAME=trend_template) — hourly cross-epic selector:
# rank all epics by R² of an upward regression, open only the best one; size by
# a martingale on the day's trailing loss streak (win→x1, each loss→xBASE).
STRATEGY_TREND_TEMPLATE_REGRESSION_PERIOD=30
STRATEGY_TREND_TEMPLATE_MIN_R2=0.80
STRATEGY_TREND_TEMPLATE_WIN_RATIO=2.0
STRATEGY_TREND_TEMPLATE_PROJECTION_HORIZON=60
STRATEGY_TREND_TEMPLATE_STOP_LOOKBACK=60
STRATEGY_TREND_TEMPLATE_STOP_BUFFER_ATR_K=0.5
STRATEGY_TREND_TEMPLATE_BASE_MULTIPLIER=3
STRATEGY_TREND_TEMPLATE_MAX_MULTIPLIER=27

# Dip rebound (STRATEGY_NAME=dip_rebound) — per-epic: buy a significant pullback
# inside a globally rising market the moment the price turns back up.
STRATEGY_DIP_REBOUND_TREND_PERIOD=60
STRATEGY_DIP_REBOUND_MIN_TREND_R2=0.55
STRATEGY_DIP_REBOUND_PULLBACK_LOOKBACK=30
STRATEGY_DIP_REBOUND_MIN_PULLBACK_ATR_K=1.5
STRATEGY_DIP_REBOUND_REBOUND_PERIOD=2
STRATEGY_DIP_REBOUND_WIN_RATIO=2.0
STRATEGY_DIP_REBOUND_STOP_LOOKBACK=10
STRATEGY_DIP_REBOUND_STOP_BUFFER_ATR_K=0.5

# Position / Risk management
STRATEGY_MAX_POSITIONS=6
STRATEGY_MAX_TRADES_DAY=50
STRATEGY_DAILY_LOSS_LIMIT=-500
STRATEGY_DAILY_WIN_TARGET=300
STRATEGY_MIN_WIN_RATE=0.40
STRATEGY_HOUR_START=9
STRATEGY_HOUR_END=16
STRATEGY_HOUR_CLOSE=17
STRATEGY_CLOSE_TARGET=follower
STRATEGY_COMPENSATE_LOOSE=false
STRATEGY_EURO_LOSS=4000
