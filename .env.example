# IG API
IG_ENV=demo
IG_API_KEY=your_api_key
IG_USERNAME=your_username
IG_PASSWORD=your_password
IG_ACCOUNT_ID=your_account_id

# Database
# Local dev (SQLite — no server needed):
DATABASE_URL=sqlite:///./ig_trading.db
# Production (PostgreSQL on a dedicated server):
# DATABASE_URL=postgresql://user:password@localhost:5432/ig_trading

# Web Interface
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Strategy selection — the three trading decisions (open / stop / close) are
# decoupled and picked independently. THIS FILE IS THE SINGLE SOURCE OF TRUTH:
# there is no code default, no database persistence and no dashboard switching —
# the dashboard only displays the active names. All three are REQUIRED; a missing
# or unknown value makes the bot/dashboard start with a "configure your .env"
# error instead of trading.
#
# All strategy parameters (Donchian channel/ATR/Efficiency-Ratio, the
# market-scanner spread gate, the trailing knobs, …) are constants on their own
# classes under src/entry/, src/stops/ and src/exit/ — tune them there. Only the
# selection names below live in the environment.
#
# The close side is split into four independently-selectable zones (follower→
# break-even, break-even→margin, margin→profit trigger, above the profit trigger)
# so each zone's stop behaviour is tuned without influencing the others.
#
# Registered names (see src/entry/__init__.py, src/stops/__init__.py,
# src/exit/zones/__init__.py):
#   OPEN_STRATEGY   : open_donchian | open_projection | open_ranking | open_saferanking | open_ultraranking | open_allincrease | open_rebound | open_slope | open_testing | open_manual
#                     open_ultraranking = open_saferanking + a HARD veto on a
#                     directionless market (efficiency ratio over the last hour
#                     below its floor -> the epic is not even ranked)
#                     two-sided (BUY + SELL): open_fade | open_pullback | open_linear | open_steady | open_five
#   STOP_STRATEGY   : stop_support | stop_atr | stop_regression | stop_linearspeed
#                     stop_hourlow (stop at the last hour's lowest low / highest high)
#                     stop_shape (picks WHICH recent level to anchor on from the
#                       shape of the curve: clean trend -> the last hour's extreme,
#                       noisy trend -> the last 3 hours', chop -> the whole session's,
#                       the last one read from the DB since it outruns the buffer)
#   CLOSE_ZONESTART : hold | trendcut | timedlift | smartgroup   (follower → break-even)
#   CLOSE_ZONEMARGE : hold | breakeven_lock | breakeven_safe | limitloose
#                                                                (break-even → margin)
#   CLOSE_ZONESECURE: hold | breakeven_half                      (margin → profit trigger)
#   CLOSE_ZONEPROFIT: trailing_ratchet | trailing_ratchetmore    (above the profit trigger)
#                     trailing_ratchetmore = trailing_ratchet + a cap on how much
#                       of the peak gain can be given back (half by default) and a
#                       trailing width that narrows as the run extends
OPEN_STRATEGY=open_ranking
STOP_STRATEGY=stop_support
CLOSE_ZONESTART=hold
CLOSE_ZONEMARGE=hold
CLOSE_ZONESECURE=hold
CLOSE_ZONEPROFIT=trailing_ratchet

# Same-day re-open policy — GLOBAL to every open strategy, REQUIRED (no code
# default: a missing value fails startup like a missing strategy name).
#   false = one opening per epic per day. Whatever the direction (BUY or SELL),
#           an epic that was already opened today is out for the rest of the day,
#           even after its position closed — the bot rotates across markets.
#   true  = several openings per epic per day: an epic is a candidate again as
#           soon as it holds no open position.
# Two concurrent positions on the same epic are ALWAYS refused, whatever the
# value. A manual open from the dashboard bypasses this policy.
ALLOW_SAME_DAY_REOPEN=false

# Recovery-revert policy — GLOBAL to every open strategy, REQUIRED (no code
# default: a missing value fails startup like a missing strategy name).
#   true  = when a position (BUY or SELL) is taken out at a LOSS by the
#           protective stop it was opened with, the bot IMMEDIATELY opens the
#           opposite side on the same epic to follow the market that turned.
#           The revert lifts the long-only gate (the reverse of a long is a
#           short) and the ALLOW_SAME_DAY_REOPEN gate (the epic was just
#           traded), but it stays an automatic open: the auto-open switch, the
#           duplicate-epic gate and the "market closes soon" gate all apply.
#           Capped at ONE hop — a revert that is itself stopped out is never
#           reverted back, so a choppy market cannot ping-pong the account.
#           The reverse trade is sized and stopped by the SAME stop policy /
#           close zones as any other open.
#   false = a stop-out is just a closed trade; the next open waits for a signal.
# Only a stop hit at the ORIGINAL level qualifies (reason_close stop / loose /
# closed_externally, i.e. the software backstop or the broker order at IG). A
# trade stopped out on a RATCHETED stop, a win, an end-of-day or a manual close
# never triggers a revert.
# The CURVE since the open must justify it too, but the filter is permissive: it
# only drops the blatant "nothing happened" cases — a stop distance covered in
# tiny steps with no single candle carrying the move (flat curve / slow leak), a
# market that chopped its way there, a trade that first ran a full risk in profit,
# or a stop merely GRAZED by a wick price has already left behind. HOLDING TIME IS
# NOT A CRITERION: twenty flat minutes then one candle through the stop is a prime
# revert. Thresholds are constants in src/execution/gates.py (curve_supports_revert).
ALLOW_RECOVERY_REVERT=true

# Backtest contract table — epic -> EUR per point, so the /backtest page can
# report a euro P&L. The candle archive holds prices only, and a single global
# EUR/point would flatten every forex trade to 0.00 EUR, so each epic's value is
# captured once from IG with:
#   python -m src.scripts.dump_euro_per_point
# A missing file is not an error: the backtest still reports its counts and
# percentage returns, and names the epics it could not price.
BACKTEST_CONTRACT_FILE=./config/euro_per_point.json
